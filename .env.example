# Arc Network Configuration
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app

# Wallet Configuration (GET FROM: https://metamask.io)
WALLET_PRIVATE_KEY=your_private_key_here_without_0x
WALLET_ADDRESS=0xYourWalletAddressHere

# Circle API Keys (GET FROM: https://console.circle.com)
CIRCLE_API_KEY=your_circle_api_key_here
KIT_KEY=KIT_KEY:your_key_id:your_key_secret

# Backend Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./compliance.db

# OpenAI API (GET FROM: https://platform.openai.com)
OPENAI_API_KEY=sk-your_openai_api_key_here

# App Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Circle Contract Addresses (Arc Testnet - DO NOT CHANGE)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B

# Optional: For production deployment
# SENTRY_DSN=your_sentry_dsn
# REDIS_URL=redis://localhost:6379
